# Localhost port exposed by the Docker reference stack. Rootless production uses its isolated runtime port.
WEB_BIND_PORT=8080

# Cloudflare Tunnel token for the dedicated avocadoss-download tunnel.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Set a long random value in production. Example: openssl rand -hex 32
DOWNLOAD_TOKEN_SECRET=
ANALYSIS_TOKEN_TTL_SECONDS=900

# Optional Netscape cookie jar used only for public media whose provider requires an
# anonymous browser session. Rootless production also auto-discovers its isolated
# services/insta-thread/config/guest.cookies.txt file when this is left blank.
YTDLP_COOKIE_FILE=

# Server-side preparation gate. This must never require an ad click.
SPONSOR_GATE_ENABLED=false
SPONSOR_GATE_SECONDS=4

# Direct sponsor / affiliate campaign. Keep disabled until a real approved campaign
# and payout account exist. The frontend loads these public presentation values at runtime.
MONETIZATION_ENABLED=false
MONETIZATION_CAMPAIGN_ID=
MONETIZATION_SPONSOR_URL=
MONETIZATION_DELAY_SECONDS=4
MONETIZATION_FREQUENCY=1
MONETIZATION_SPONSOR_LABEL=Sponsored message
MONETIZATION_SPONSOR_TITLE=A short message from our sponsor
MONETIZATION_SPONSOR_TEXT=
MONETIZATION_SPONSOR_CTA=Visit sponsor
MONETIZATION_DISCLOSURE=Some links may be affiliate links. A purchase may generate a commission at no extra cost to you.
MONETIZATION_METRICS_FILE=/data/metrics/monetization.json

# miniPC resource protection.
MAX_JOBS=100
MAX_MEDIA_MB=750
MIN_FREE_GB=5
JOB_TTL_SECONDS=1800
READY_JOB_TTL_SECONDS=600
ERROR_JOB_TTL_SECONDS=120
